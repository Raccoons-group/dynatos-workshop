{
  "extends": "@workshop/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": [
    "components/**/*.vue",
    "layouts/**/*.vue",
    "global-top.vue",
    "composables/**/*.ts",
    "styles/**/*.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
