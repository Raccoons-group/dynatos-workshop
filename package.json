{
  "name": "dynatos-workshop",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "skills:link": "node scripts/link-skills.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "setup:check": "node scripts/setup-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/link-skills.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3"
  }
}
